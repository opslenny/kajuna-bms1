# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
# Application-level connection (limited privileges – used at runtime)
DATABASE_URL=postgresql://kajuna_app:change_this_app_password@localhost:5432/kajuna_bms

# Owner-level connection (used only for migrations and test database setup)
MIGRATION_DATABASE_URL=postgresql://kajuna_owner:change_this_owner_password@localhost:5432/kajuna_bms

# Maximum number of connections the application connection pool can open
DATABASE_POOL_SIZE=10

# ─── Docker Compose Postgres init (only needed when running via docker-compose) ─
POSTGRES_DB=kajuna_bms
POSTGRES_USER=kajuna_owner
POSTGRES_PASSWORD=change_this_owner_password
POSTGRES_APP_PASSWORD=change_this_app_password

# ─── Application ────────────────────────────────────────────────────────────────
# Port the Node.js API server listens on
API_PORT=3001

# Full origin of the web frontend (used for CORS same-origin check on mutations)
APP_ORIGIN=http://localhost:5173
# Optional comma-separated exact origins, for multiple local/prod frontend URLs.
# When set, this list replaces APP_ORIGIN; do not use wildcard origins.
APP_ORIGINS=

# Random secret used once to bootstrap the first business / platform admin.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Remove or leave blank after initial setup.
SETUP_TOKEN=

# Optional system-owner bootstrap. When both are set, the API creates this
# account only if no platform owner exists. The password is stored as a hash
# in the database; changing these values later does not reset the account.
PLATFORM_OWNER_NAME=System Owner
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
# Set true only to convert a single matching business-admin account to the
# system owner. The business account is disabled and its sessions revoked;
# a separate platform-owner account is created so historical business records stay linked.
PLATFORM_OWNER_PROMOTE_EXISTING=false

# ─── Google OAuth (One Tap / Sign In With Google) ───────────────────────────────
# The public Web client ID created in Google Cloud Console → APIs & Services →
# Credentials → OAuth 2.0 Client IDs (type: "Web application").
#
# Steps:
#  1. Go to https://console.cloud.google.com/
#  2. Create or select your project.
#  3. Enable "Google Identity" (no extra API needed – GSI is free).
#  4. Navigate to APIs & Services → Credentials → + CREATE CREDENTIALS →
#     OAuth 2.0 Client ID → Application type: Web application.
#  5. Add your domain(s) to "Authorised JavaScript origins":
#       http://localhost:5173        (local dev)
#       https://your-production-domain.com
#  6. No "Authorised redirect URIs" needed for Sign In With Google (One Tap).
#  7. Copy the "Client ID" (ends with .apps.googleusercontent.com) here.
#
# Leave blank to disable Google sign-in (email+password login still works).
GOOGLE_CLIENT_ID=
